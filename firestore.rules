rules_version = '2';
// Project Firebase "city". Publik membaca cityArticles/cityConfig dan foto approved. Penulisan lain hanya admin.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['diasadhityap@gmail.com', 'fvcktherules3404@gmail.com'];
    }
    // Progres per ARTIKEL (tanpa data order, pembeli, atau resi).
    match /cityArticles/{id} { allow read: if true; allow write: if isAdmin(); }
    match /cityConfig/{id}   { allow read: if true; allow write: if isAdmin(); }

    // Galeri: publik hanya boleh MEMBUAT foto berstatus pending (field terbatas) dan MEMBACA yang approved.
    function okNum(v, lo, hi) { return v == null || (v is number && v >= lo && v <= hi); }
    match /cityGallery/{id} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow create: if isAdmin() || (
        request.resource.data.keys().hasOnly(['url','thumb','ig','caption','place','cityX','cityZ','cityY','cityArea','lat','lng','placeName','status','device','createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.url is string && request.resource.data.url.matches('https://res\\.cloudinary\\.com/.*') && request.resource.data.url.size() < 400
        && request.resource.data.thumb is string && request.resource.data.thumb.size() < 500
        && request.resource.data.ig is string && request.resource.data.ig.size() <= 30
        && request.resource.data.caption is string && request.resource.data.caption.size() <= 200
        && request.resource.data.place is string && request.resource.data.place.size() <= 60
        && request.resource.data.placeName is string && request.resource.data.placeName.size() <= 120
        && request.resource.data.cityArea is string && request.resource.data.cityArea.size() <= 120
        && request.resource.data.device is string && request.resource.data.device.size() <= 60
        && request.resource.data.cityX is number && request.resource.data.cityX >= -200 && request.resource.data.cityX <= 300
        && request.resource.data.cityZ is number && request.resource.data.cityZ >= -270 && request.resource.data.cityZ <= 120
        && okNum(request.resource.data.get('cityY', null), -5, 200)
        && okNum(request.resource.data.get('lat', null), -90, 90) && okNum(request.resource.data.get('lng', null), -180, 180));
      allow update, delete: if isAdmin();
    }

    // Statistik pengunjung: situs menaikkan hitungan harian lewat pelacak (ftr-track.js); hanya admin yang boleh membaca.
    match /stats/{id} {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['site','day','hits','uniq','fresh'])
        && request.resource.data.site in ['web','game','kota','jurnal']
        && request.resource.data.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && id == 'd_' + request.resource.data.site + '_' + request.resource.data.day
        && request.resource.data.hits == 1
        && request.resource.data.uniq in [0, 1] && request.resource.data.fresh in [0, 1];
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hits', 'uniq', 'fresh'])
        && request.resource.data.hits == resource.data.hits + 1
        && request.resource.data.uniq - resource.data.uniq in [0, 1]
        && request.resource.data.fresh - resource.data.fresh in [0, 1];
    }
    // Aktivitas pelanggan per perangkat per hari (ftr-track.js): urutan aksi + jam. Situs hanya boleh MENAMBAH aksi (maks 12 per penulisan,
    // maks 400 per perangkat per hari); hanya admin yang boleh membaca. Isi alamat/nama/HP tidak pernah dikirim.
    match /aktivitas/{id} {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['dev','day','ua','ev'])
        && request.resource.data.dev.matches('^[a-z0-9]{8,16}$')
        && request.resource.data.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && id == request.resource.data.day + '_' + request.resource.data.dev
        && request.resource.data.ua is string && request.resource.data.ua.size() <= 40
        && request.resource.data.ev is list && request.resource.data.ev.size() >= 1 && request.resource.data.ev.size() <= 12;
      allow update: if request.resource.data.keys().hasOnly(['dev','day','ua','ev'])
        && request.resource.data.dev == resource.data.dev
        && request.resource.data.day == resource.data.day
        && request.resource.data.ua is string && request.resource.data.ua.size() <= 40
        && request.resource.data.ev is list
        && request.resource.data.ev.size() >= resource.data.ev.size()
        && request.resource.data.ev.size() <= resource.data.ev.size() + 12
        && request.resource.data.ev.size() <= 400;
    }
    // Riwayat chat AI di dasbor admin.
    match /adminChats/{id} { allow read, write: if isAdmin(); }
  }
}
